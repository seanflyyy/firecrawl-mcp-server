{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.firecrawl/firecrawl-mcp-server",
  "title": "Firecrawl MCP Server",
  "description": "Firecrawl, the context API for AI agents: search, scrape, interact with the web, plus paper search.",
  "version": "3.40.0",
  "repository": {
    "url": "https://github.com/firecrawl/firecrawl-mcp-server.git",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "firecrawl-mcp",
      "version": "3.40.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Your API key for Firecrawl",
          "isRequired": false,
          "format": "string",
          "isSecret": true,
          "name": "FIRECRAWL_API_KEY"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://b5e7-42-60-104-100.ngrok-free.app/main/mcp"
    }
  ]
}
